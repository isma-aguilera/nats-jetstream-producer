{
  "uid": "nats-jetstream-lab",
  "title": "NATS JetStream - Lab Overview",
  "tags": ["nats", "jetstream", "lab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    { "type": "row", "title": "Cluster Overview", "gridPos": {"h":1,"w":24,"x":0,"y":0}, "id": 1, "collapsed": false },

    { "type": "stat", "title": "Servers Up", "id": 2,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":4,"w":4,"x":0,"y":1},
      "fieldConfig": {"defaults": {"unit":"none","thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":3}]}},"overrides":[]},
      "options": {"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"]}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"count(up{namespace=\"nats-system\"} == 1)"}]
    },
    { "type": "stat", "title": "Client Connections", "id": 3,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":4,"w":4,"x":4,"y":1},
      "fieldConfig": {"defaults": {"unit":"none"},"overrides":[]},
      "options": {"colorMode":"value","graphMode":"area","reduceOptions":{"calcs":["lastNotNull"]}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(nats_varz_connections{namespace=\"nats-system\"})"}]
    },
    { "type": "stat", "title": "Client Subscriptions", "id": 4,
      "description": "Subscriptions held by client connections (from connz). Excludes the ~221/server internal JetStream/system/RAFT subscriptions reported by varz.",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":4,"w":4,"x":8,"y":1},
      "fieldConfig": {"defaults": {"unit":"none"},"overrides":[]},
      "options": {"colorMode":"value","graphMode":"area","reduceOptions":{"calcs":["lastNotNull"]}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(nats_connz_subscriptions{namespace=\"nats-system\"})"}]
    },
    { "type": "stat", "title": "JetStream Streams", "id": 5,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":4,"w":4,"x":12,"y":1},
      "fieldConfig": {"defaults": {"unit":"none"},"overrides":[]},
      "options": {"colorMode":"value","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"]}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max(nats_server_total_streams{namespace=\"nats-system\"})"}]
    },
    { "type": "stat", "title": "JetStream Consumers", "id": 6,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":4,"w":4,"x":16,"y":1},
      "fieldConfig": {"defaults": {"unit":"none"},"overrides":[]},
      "options": {"colorMode":"value","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"]}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max(nats_server_total_consumers{namespace=\"nats-system\"})"}]
    },
    { "type": "stat", "title": "JS Messages Stored", "id": 7,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":4,"w":4,"x":20,"y":1},
      "fieldConfig": {"defaults": {"unit":"short"},"overrides":[]},
      "options": {"colorMode":"value","graphMode":"area","reduceOptions":{"calcs":["lastNotNull"]}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max(nats_server_total_messages{namespace=\"nats-system\"})"}]
    },

    { "type": "row", "title": "Throughput", "gridPos": {"h":1,"w":24,"x":0,"y":5}, "id": 10, "collapsed": false },

    { "type": "timeseries", "title": "Messages / sec (in & out)", "id": 11,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":8,"w":12,"x":0,"y":6},
      "fieldConfig": {"defaults": {"unit":"ops","custom":{"drawStyle":"line","fillOpacity":10}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom","calcs":["mean","lastNotNull"]},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (pod) (rate(nats_varz_in_msgs{namespace=\"nats-system\"}[$__rate_interval]))","legendFormat":"{{pod}} in"},
        {"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (pod) (rate(nats_varz_out_msgs{namespace=\"nats-system\"}[$__rate_interval]))","legendFormat":"{{pod}} out"}
      ]
    },
    { "type": "timeseries", "title": "Throughput bytes / sec (in & out)", "id": 12,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":8,"w":12,"x":12,"y":6},
      "fieldConfig": {"defaults": {"unit":"Bps","custom":{"drawStyle":"line","fillOpacity":10}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom","calcs":["mean","lastNotNull"]},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (pod) (rate(nats_varz_in_bytes{namespace=\"nats-system\"}[$__rate_interval]))","legendFormat":"{{pod}} in"},
        {"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (pod) (rate(nats_varz_out_bytes{namespace=\"nats-system\"}[$__rate_interval]))","legendFormat":"{{pod}} out"}
      ]
    },

    { "type": "row", "title": "Server Resources", "gridPos": {"h":1,"w":24,"x":0,"y":14}, "id": 20, "collapsed": false },

    { "type": "timeseries", "title": "CPU per server", "id": 21,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":8,"w":8,"x":0,"y":15},
      "fieldConfig": {"defaults": {"unit":"percent","custom":{"drawStyle":"line","fillOpacity":10}},"overrides":[]},
      "options": {"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"nats_varz_cpu{namespace=\"nats-system\"}","legendFormat":"{{pod}}"}]
    },
    { "type": "timeseries", "title": "Memory per server", "id": 22,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":8,"w":8,"x":8,"y":15},
      "fieldConfig": {"defaults": {"unit":"bytes","custom":{"drawStyle":"line","fillOpacity":10}},"overrides":[]},
      "options": {"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"nats_varz_mem{namespace=\"nats-system\"}","legendFormat":"{{pod}}"}]
    },
    { "type": "timeseries", "title": "Connections & Slow consumers", "id": 23,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":8,"w":8,"x":16,"y":15},
      "fieldConfig": {"defaults": {"unit":"none","custom":{"drawStyle":"line","fillOpacity":10}},"overrides":[]},
      "options": {"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"nats_varz_connections{namespace=\"nats-system\"}","legendFormat":"{{pod}} conns"},
        {"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"nats_varz_slow_consumers{namespace=\"nats-system\"}","legendFormat":"{{pod}} slow"}
      ]
    },

    { "type": "row", "title": "JetStream", "gridPos": {"h":1,"w":24,"x":0,"y":23}, "id": 30, "collapsed": false },

    { "type": "timeseries", "title": "JS Memory used", "id": 31,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":8,"w":6,"x":0,"y":24},
      "fieldConfig": {"defaults": {"unit":"bytes","custom":{"drawStyle":"line","fillOpacity":10}},"overrides":[]},
      "options": {"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"nats_varz_jetstream_stats_memory{namespace=\"nats-system\"}","legendFormat":"{{pod}}"}]
    },
    { "type": "timeseries", "title": "JS Storage used", "id": 32,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":8,"w":6,"x":6,"y":24},
      "fieldConfig": {"defaults": {"unit":"bytes","custom":{"drawStyle":"line","fillOpacity":10}},"overrides":[]},
      "options": {"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"nats_varz_jetstream_stats_storage{namespace=\"nats-system\"}","legendFormat":"{{pod}}"}]
    },
    { "type": "timeseries", "title": "JS API calls / sec", "id": 33,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":8,"w":6,"x":12,"y":24},
      "fieldConfig": {"defaults": {"unit":"ops","custom":{"drawStyle":"line","fillOpacity":10}},"overrides":[]},
      "options": {"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (pod) (rate(nats_varz_jetstream_stats_api_total{namespace=\"nats-system\"}[$__rate_interval]))","legendFormat":"{{pod}}"}]
    },
    { "type": "timeseries", "title": "JS API errors / sec", "id": 34,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":8,"w":6,"x":18,"y":24},
      "fieldConfig": {"defaults": {"unit":"ops","custom":{"drawStyle":"line","fillOpacity":10}},"overrides":[]},
      "options": {"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (pod) (rate(nats_varz_jetstream_stats_api_errors{namespace=\"nats-system\"}[$__rate_interval]))","legendFormat":"{{pod}}"}]
    },

    { "type": "row", "title": "Streams", "gridPos": {"h":1,"w":24,"x":0,"y":32}, "id": 40, "collapsed": false },

    { "type": "timeseries", "title": "Messages per stream", "id": 41,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":8,"w":12,"x":0,"y":33},
      "fieldConfig": {"defaults": {"unit":"short","custom":{"drawStyle":"line","fillOpacity":10}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull"]},"tooltip":{"mode":"multi"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (stream_name) (nats_stream_total_messages{namespace=\"nats-system\"})","legendFormat":"{{stream_name}}"}]
    },
    { "type": "timeseries", "title": "Bytes per stream", "id": 42,
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": {"h":8,"w":12,"x":12,"y":33},
      "fieldConfig": {"defaults": {"unit":"bytes","custom":{"drawStyle":"line","fillOpacity":10}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull"]},"tooltip":{"mode":"multi"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (stream_name) (nats_stream_total_bytes{namespace=\"nats-system\"})","legendFormat":"{{stream_name}}"}]
    }
  ]
}
