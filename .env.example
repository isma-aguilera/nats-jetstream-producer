# Copy to .env and adjust. NEVER commit the real .env or any .creds file.

# --- Connection ---
NATS_URL=nats://localhost:4222
# Path to a NATS credentials file for authenticated clusters.
# Mount it as a secret in k8s; do not hardcode tokens/passwords.
# NATS_CREDS=/secrets/nats.creds

# --- Stream (only used to CREATE the stream if it does not exist) ---
STREAM_NAME=LAB
STREAM_SUBJECTS=lab.>
STREAM_REPLICAS=1

# --- Producer behaviour ---
SUBJECT=lab.events
PUBLISH_INTERVAL=1s
# 0 = publish forever
MAX_MESSAGES=0
